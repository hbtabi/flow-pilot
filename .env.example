# Only used with --live. Mock mode (the default) never reads these and never touches the network.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Referenced from the example workflows via {{ env.get('...') }}
SLACK_WEBHOOK_URL=
ESCALATION_WEBHOOK_URL=

# Sender shown on generated email drafts (drafts are written to disk, never sent)
FLOWPILOT_FROM=me@example.com
# Require this header value (X-Flow-Pilot-Token) on `flow-pilot serve` webhooks
FLOWPILOT_TOKEN=
